# .env.leader.example — leader-only overrides for the unified docker-compose.yml
# =============================================================================
# The tracked compose ships FOLLOWER-SAFE defaults (each equals the code default,
# verified against the source). A follower needs NONE of this file. The LEADER
# restores its real behavior with these overrides — copy to `.env` on the leader
# (dc.sh merges it with the secrets in .env.keys).
#
# WITHOUT these, a leader started from the unified compose would silently regress:
# provenance enforcement OFF, no candidate-image push, live champion on
# --network=none, unbounded submission store, proxy headers untrusted, etc.
#
# Infra endpoints and all secrets are PLACEHOLDERS — fill them from the vault /
# .env.keys. Never commit real endpoints, IPs, tokens, or keys.

# --- role selection -------------------------------------------------------
# NOTE: no `autoupdate` — the leader deploys via the update.sh cron, NOT watchtower.
COMPOSE_PROFILES=leader,benchmark-worker
ENABLE_SOLVER_ROUND_COORDINATOR=1        # api runs the round coordinator
ENABLE_BENCHMARK_WORKER=0                 # 0 on the API: the benchmark-worker CONTAINER runs the
                                          # slate loop (its compose map hardcodes its own 1); api=1
                                          # would run BOTH and double-benchmark (#387 class)
SUBMISSIONS_ACCEPTING=1                   # leader accepts user submissions (compose default 0)
ENABLE_DEX_COMPARE=1                      # DEX-aggregator comparison (compose default 0)
RELAYER_URL=http://relayer:8091          # use the LOCAL relayer container (default: public relayer)

# --- round lifecycle ------------------------------------------------------
SOLVER_ROUND_OPEN_SECONDS=1200           # 20-min open window (= code default; pinned for explicitness)
SUBMISSIONS_MAX_RECORDS=5000             # store retention cap (code default 0 = unbounded)
SUBMISSIONS_MAX_ROUNDS_PER_FINGERPRINT=2 # per-fingerprint round cap (box value; code default 2)

# --- operator merges (one operator = one queue identity) -------------------
# The per-actor caps (SUBMISSIONS_MAX_PER_ACTOR_PER_ROUND=1, the seniority
# clock, the build budget, the slate) all key on the ACTOR. A ring of N coldkeys
# with one hotkey each, each under its own github account, is N actors — every
# cap satisfied N times in parallel. These levers supply the missing edge; no
# new cap and no new reject path.
#STRUCTURAL_ACTOR_MERGE_MODE=enforce      # off | observe (code default: record +
                                          # log the merges it WOULD make) |
                                          # enforce (apply them). ENFORCE CHANGES
                                          # THE BENCHED SLATE → THE PACK HASH:
                                          # promote fleet-uniform before arming.
#STRUCTURAL_ACTOR_MERGE_MIN_ROUNDS=3      # distinct rounds a pair must co-ship
                                          # identical structure to merge (code
                                          # default 3; live ring: 25 of 26)
#STRUCTURAL_ACTOR_MERGE_TTL_DAYS=30       # evidence decay (0 = never expire)
#SOLVER_ACTOR_STATIC_MERGE=0              # kill-switch for the in-code list of
                                          # proven rings (default ON)
#SOLVER_ACTOR_MERGE_EXTRA=ckA,ckB;ckC,ckD # add a freshly-caught ring w/o a deploy
ROUND_ANCHOR_SHADOW=1

# --- provenance enforcement (leader-only) ---------------------------------
# The box currently runs BOTH at 0 (observe-only). Arming to 1 REQUIRES the
# signer list below — do not set 1 here just because it sounds safer.
REQUIRE_SIGNED_PROVENANCE=0
REQUIRE_ASYMMETRIC_PROVENANCE=0
SUBMISSION_PROVENANCE_ALLOWED_SIGNERS=<REDACTED — allowed provenance signer set>

# --- champion / live solver ----------------------------------------------
# RECOMMENDED: route the live champion's RPC through the KEYLESS metered proxy.
# runtime_solver.py then lands the champion on a dedicated `--internal`
# `live-solver` net where it can reach ONLY the proxy: it holds no provider API
# key, and its per-order RPC is metered (LIVE_SOLVER_RPC_BUDGET, default 5000).
# When enabled, this OVERRIDES the legacy LIVE_SOLVER_NETWORK at runtime, so
# there is nothing to rename; if the proxy fails to attach, the code FAILS SAFE
# back to the legacy direct-RPC path (keyed) — watch the api log for
# "Live champion RPC routed through keyless metered proxy".
LIVE_SOLVER_RPC_VIA_PROXY=1
# Proxy path verified live 2026-07 — champion is REFUSED on any non-internal
# net (fail-closed) instead of silently falling back to the keyed path.
LIVE_SOLVER_REQUIRE_INTERNAL=1
LIVE_SOLVER_RPC_BUDGET=5000               # per-order metered RPC budget (code default 5000)
# LEGACY (deprecated): direct-RPC champion on the real docker net — this hands
# an untrusted container a network with keyed RPC egress. Only relevant while
# LIVE_SOLVER_RPC_VIA_PROXY=0 (it is IGNORED while the proxy path is on).
# Leave unset unless you must reproduce the pre-proxy behavior.
#LIVE_SOLVER_NETWORK=production_minotaur
CANDIDATE_IMAGE_REPO=ghcr.io/subnet112/minotaur-solver  # non-empty ⇒ leader pushes candidate digests
EMISSION_TIME_WEIGHTED_OBSERVE=1          # observe-only time-weighted emission soak
CHAMPION_CONSENSUS_TIMEOUT_SECONDS=120    # (code default 30)

# --- ingress / perf -------------------------------------------------------
TRUST_PROXY_HEADERS=1                     # api behind nginx — honor X-Forwarded-For
RPC_PROXY_PIN_CACHE_MAX_BLOCKS=32         # (code default 4)
RPC_PROXY_PIN_CACHE_PERSIST_PATH=/var/cache/pin-proxy/snapshot.json
RELAYER_MIN_BALANCE_WEI=1000000000000000  # 0.001 (embedded-relayer path; api uses HttpRelayer)

# --- image tag + host bind-mount paths (compose defaults are follower-safe) --
MINOTAUR_IMAGE_TAG=latest                     # leader tracks :latest (compose default :stable)
BITTENSOR_WALLET_PATH=/home/ubuntu/minotaur/wallets     # compose default ${HOME}/.bittensor/wallets
SOLVER_REPO_HOST_PATH=/home/ubuntu/minotaur-solver      # host solver-repo checkout → /solver-repo
GHCR_DOCKER_CONFIG_DIR=/home/ubuntu/minotaur/.ghcr-docker  # GHCR push creds → /home/minotaur/.docker

# --- screening / registries -----------------------------------------------
SOLVER_REPO_PATH=/solver-repo
SUBMISSION_GIT_CLONE_USERNAME=x-access-token   # GitHub token-auth username (not a secret)
ALLOW_ADMIN_SOLVER_REPO_TOKEN=1
STAGE3_DISABLED=1                              # leader disables Stage-3 regression (code default 0)
APP_REGISTRY_1=0xbA70eA9857c3813A694f6CA71Fa98eA6E584dF1B        # ETH-mainnet AppRegistry (public)
VALIDATOR_REGISTRY_1=0x694F0a95D3105EcC2ad86FcaFAa1A4467F1852A6  # ETH-mainnet ValidatorRegistry (public)
# Identity (public ss58, but validator-specific — fill per deployment):
VALIDATOR_HOTKEY_SS58=<this validator's hotkey ss58>
SUBNET_OWNER_HOTKEY=<subnet owner hotkey ss58>

# --- infra endpoints (PLACEHOLDERS — fill per environment) ----------------
API_URL=http://<leader-host>:8080
COW_BASE_URL=<cow-onchain proxy base url>
DEX_COMPARE_SOURCE=cow_onchain
DEX_COMPARE_CHAINS=1,8453
DEX_COMPARE_COW_APP_ID=<chain:app_id pairs>
ORDER_CONSENSUS_PEERS=<order-consensus peer list>
# LEADER_API_URL is a FOLLOWER-oriented var (followers point at the leader). Its
# compose default is the public https://api.minotaursubnet.com — self-referential
# on the leader's own validator. Point it local (or leave empty if unused on the leader):
LEADER_API_URL=http://api:8080

# --- event-loop + ingress protections (post-incident, 2026-07) -------------
SIM_OFFLOAD_TO_THREAD=1                   # run blocking anvil sims in a worker thread
                                          # (#1056/#1068; = code default now — 0 is the
                                          # kill-switch back to the inline path that
                                          # froze the api in the 2026-07-24 incident)
QUOTE_RATE_LIMIT_PER_MINUTE=20            # per-IP /quote cap behind nginx (DDoS Tier1; = code default)

# --- round windows (re-widened 2026-07-25 after finalist aborts) -----------
SOLVER_ROUND_DECISION_EPOCHS=70           # (= code default)
SOLVER_ROUND_DECISION_BASE_EPOCHS=24      # (= code default)
SOLVER_ROUND_DECISION_PER_SUB_EPOCHS=15   # (= code default)
SOLVER_ROUND_ACTIVATION_DELAY_EPOCHS=72   # (= code default)
SOLVER_ROUND_MAX_SUBMISSIONS=3            # bench slate width (sim-bound)
SOLVER_ROUND_INTAKE_MAX=8                 # build-budget intake cap (code default 8)
#SOLVER_BUILD_STRUCTURAL_DEDUP=1          # build units prefer UNBUILT structural
                                          # fingerprints, not just fresh actors.
                                          # Unset = follow the slate lever (on iff
                                          # STRUCTURAL_DEDUP_MODE=enforce); 0 =
                                          # kill-switch. Without it an identical-code
                                          # coldkey fleet takes 7/8 units and the
                                          # enforce slate collapses them to one seat,
                                          # benching 2 of 3 slots (2026-07-27).

# --- benchmarking ----------------------------------------------------------
# REDUNDANT: default ON in code since #806 (round_anchor.benchmark_all_
# deployment_chains_enabled returns True when unset — only an explicit
# 0/false/no/off disables). Followers get it from the image, not from env, so
# there is nothing to set per-node; the canonical compose already ships the
# prerequisites (anvil-eth ungated, SOLVER_READ_PROXY_CHAINS defaults to
# "8453,1"). Kept here only to document the leader's actual environment.
BENCHMARK_ALL_DEPLOYMENT_CHAINS=1
BENCHMARK_QUOTE_CORPUS=1                  # /quote-derived Stage-2 corpus (#924)
BENCHMARK_CONCURRENCY=1
BENCHMARK_POLL_INTERVAL=30
BENCHMARK_HISTORICAL_SAMPLES=10
STAGE3_MAX_REGRESSION_CHECKS=5

# --- consensus / scoring (box values; most equal code defaults) ------------
CONSENSUS_MODE=real
CONSENSUS_REQUIRE_SIGNED_PROPOSALS=1
QUORUM_BPS=6666
ORDER_CONSENSUS_QUORUM_BPS=6666
CHAMPION_CONSENSUS_CHAIN_ID=964
CHALLENGER_QUORUM_MODE=1
RELATIVE_SCORING_ENABLED=1
SCORE_THRESHOLD=5000
DISTRIBUTED_VETO_ENFORCE=hard             # = code default; listed for visibility
DISTRIBUTED_VETO_REVERIFY=1
ALLOW_CHAMPION_HOT_SWAP=1
ENABLE_PUBLIC_DEPLOYMENT=1                # leader serves public app deploys
SUBMISSION_SNAPSHOT_SYNC=1

# --- chain identity + public registry addresses ----------------------------
NETUID=112
SUBTENSOR_URL=finney
CHAMPION_REGISTRY_964=0x33105027d03e76bf1F3679C0CB9b2688da383fb3
VALIDATOR_REGISTRY_964=0x0B5fE44e90515571761D86C28c4855F325EDE098
VALIDATOR_REGISTRY_8453=0x88a08d1105393EACE9B6f5ff678DbE508B8639aC
APP_REGISTRY_964=0x80758D3Bf11715c82dB9964C634d5Fd8a0C58aBF
APP_REGISTRY_8453=0x0B5fE44e90515571761D86C28c4855F325EDE098
APP_INTENT_BASE_964=0xBAF0d7D33F89aD7959399b502F273AC0fD1C1981
APP_ADMIN_SIGNERS=0x7dC30109A32764f808823095C576A0355b7978d6
DEPLOY_FEE_COLLECTOR_EVM=0x7dC30109A32764f808823095C576A0355b7978d6
DEPLOY_FEE_EXEMPT_ADDRESSES=0x7dC30109A32764f808823095C576A0355b7978d6
GENESIS_SOLVER_IMAGE=ghcr.io/subnet112/minotaur-solver:latest
MALLOC_ARENA_MAX=2

# --- secrets: set in .env.keys, NOT here ----------------------------------
# RELAYER_PRIVATE_KEY, VALIDATOR_PRIVATE_KEY, VALIDATOR_ADDRESSES, ADMIN_API_KEY,
# SOLVER_ROUND_INTERNAL_API_KEY, SOLVER_REPO_TOKEN, SUBMISSION_GIT_CLONE_PASSWORD,
# BITTENSOR_EVM_RELAYER_RPC_URL  (the relayer's BT-EVM RPC — carries an auth token)

# =============================================================================
# The structural gaps a `docker compose config` diff vs the live
# docker-compose.production.yml surfaced are now handled IN the compose:
#   - image tag → ${MINOTAUR_IMAGE_TAG:-stable}   (set MINOTAUR_IMAGE_TAG=latest above)
#   - wallet path → ${BITTENSOR_WALLET_PATH:-...}  (set above)
#   - leader-only api mounts /solver-repo + /home/minotaur/.docker → parameterized
#     (followers mount empty .leader-mounts/* placeholders; leader sets the host paths above)
#   - validator store-data:/data → added
#   - box-only env vars: NOT duplicated in the compose env maps — they flow to
#     the containers via the OPTIONAL `env_file: .env.leader` on the coordinator
#     services (absent on followers = no-op), so compose never carries a second
#     copy of an app default that can drift
# Verify with:  COMPOSE_PROFILES=leader,benchmark-worker docker compose \
#   -f docker-compose.yml --env-file .env --env-file .env.keys config
# then diff that against the box's live render — the only differences should be the
# intended overrides in this file.
#
# NOTE: the leader also GAINS a few vars the (older) box compose lacked but the
# current follower compose carries — mostly benign (empty, local container URLs,
# code defaults). Two to CONFIRM are intended fleet-consistency (the leader runs
# :latest code, which expects them): CONSENSUS_ENFORCE_ONCHAIN_REGISTRY=1,
# CONSENSUS_REQUIRE_SIGNED_CHAMPION_PROPOSALS=1, CONSENSUS_MODE=real.
# =============================================================================
